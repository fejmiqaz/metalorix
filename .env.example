DEBUG=True
# Local development works without changing these settings.
# For deployment use a random SECRET_KEY and DEBUG=False.
SECRET_KEY=local-development-only-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave blank for local SQLite. Use the Neon connection string with sslmode=require in production.
DATABASE_URL=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v25.0
