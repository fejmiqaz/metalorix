DEBUG=True
# Local development works without changing these settings.
# For deployment use a random SECRET_KEY and DEBUG=False.
SECRET_KEY=local-development-only-do-not-use-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Leave blank for local SQLite. Use the Neon connection string with sslmode=require in production.
DATABASE_URL=
# Owner notifications (off until configured). Console backend is local preview only.
IDEA_NOTIFICATIONS_ENABLED=False
IDEA_NOTIFICATION_EMAIL=
# Render Free: use resend (HTTPS), not SMTP.
IDEA_EMAIL_PROVIDER=django
RESEND_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=metalorix@localhost
SITE_URL=http://127.0.0.1:8000
# Required automatically in production. Optional locally.
TURNSTILE_REQUIRED=False
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
